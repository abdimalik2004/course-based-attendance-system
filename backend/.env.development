JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=attendance
MYSQL_ADMIN_DB=mysql

# SQLite is no longer the default backend database.
# SQLITE_PATH=backend/database/attendance.db

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=DEBUG
SCHEDULER_POLL_SECONDS=60
DEFAULT_GRACE_PERIOD_MINUTES=10
# Must stay ≤ ATTENDANCE_EMBEDDING_MIN_SIMILARITY (0.60 in root .env) so this
# gate never silently rejects a match the recognizer already accepted.
FACE_CONFIDENCE_THRESHOLD=0.58
FACE_TIMEOUT_SECONDS=2.0

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
FRAME_RATE_LIMIT_REQUESTS=180
FRAME_RATE_LIMIT_WINDOW_SECONDS=60

