APP_NAME=Course Attendance Backend
APP_ENV=development
SECRET_KEY=replace_with_minimum_32_char_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

DB_TYPE=sqlite
SQLITE_PATH=backend/database/attendance.db

# For MySQL set DB_TYPE=mysql and configure below.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=attendance
MYSQL_ADMIN_DB=mysql

TENANT_DB_AUTO_PROVISION_ENABLED=true
TENANT_DB_RUNTIME_ROUTING_ENABLED=false
TENANT_DB_PREFIX=tenant_
TENANT_DB_CHARSET=utf8mb4
TENANT_DB_COLLATION=utf8mb4_unicode_ci

SCHEDULER_POLL_SECONDS=60
DEFAULT_GRACE_PERIOD_MINUTES=10
FACE_CONFIDENCE_THRESHOLD=0.60
FACE_TIMEOUT_SECONDS=2.0

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO

# Rate limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
FRAME_RATE_LIMIT_REQUESTS=180
FRAME_RATE_LIMIT_WINDOW_SECONDS=60
