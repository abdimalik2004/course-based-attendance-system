APP_NAME=Course Attendance Backend
APP_ENV=development
SECRET_KEY=replace_with_minimum_32_char_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

DB_TYPE=mysql

# MySQL backend database settings.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=attendance
MYSQL_ADMIN_DB=mysql

# SQLite fallback (optional, no longer the default backend DB).
# SQLITE_PATH=backend/database/attendance.db

SCHEDULER_POLL_SECONDS=60
DEFAULT_GRACE_PERIOD_MINUTES=10
FACE_CONFIDENCE_THRESHOLD=0.60
FACE_TIMEOUT_SECONDS=2.0

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO

# Rate limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
FRAME_RATE_LIMIT_REQUESTS=180
FRAME_RATE_LIMIT_WINDOW_SECONDS=60
